    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "he": "^1.2.0",
    "helmet": "^8.2.0",
    "nodemailer": "^8.0.7",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "twilio": "^6.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/express-session": "^1.19.0",
    "@types/he": "^1.2.3",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.8"
